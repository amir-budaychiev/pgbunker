# Rendered by scripts/nginx-setup.sh to /etc/nginx/snippets/pgbunker-logs.conf
# and included from the main pgbunker server block.
#
# vmui is the VictoriaLogs UI. Same realm and same htpasswd as Grafana, PgHero
# and Dozzle, so the browser asks once and reuses it for all four panels.
# Everything under /select/ is read-only in VictoriaLogs; writes live under
# /insert/, which is served separately and is off unless you turn it on.

location /select/ {
    auth_basic           "PgBunker panels";
    auth_basic_user_file /etc/nginx/pgbunker-panels.htpasswd;

    proxy_pass http://127.0.0.1:9428;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
}
