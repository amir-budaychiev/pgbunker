# Rendered by scripts/nginx-setup.sh to /etc/nginx/sites-available/pgbunker.
# Variables substituted: ${DOMAIN}
#
# HTTP-only at first. `certbot --nginx` then clones this block as HTTPS with
# the issued certificate and adds the HTTP->HTTPS redirect.
#
# One subdomain, path-routed: panels live under /grafana, /pghero, /dozzle.
# Each app is told its own base path, so links and assets stay prefixed.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${DOMAIN};

    # Landing page with links to the panels.
    location = / {
        root /var/www/pgbunker;
        try_files /index.html =404;
    }

    # Grafana — GF_SERVER_SERVE_FROM_SUB_PATH keeps it under /grafana.
    location /grafana {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Grafana Live uses WebSocket
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # PgHero — RAILS_RELATIVE_URL_ROOT=/pghero.
    location /pghero {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Dozzle — DOZZLE_BASE=/dozzle. Streams logs via WebSocket/SSE.
    location /dozzle {
        proxy_pass http://127.0.0.1:8888;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering    off;
        proxy_read_timeout 3600s;
    }
}
