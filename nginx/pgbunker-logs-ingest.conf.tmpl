
# Appended to /etc/nginx/snippets/pgbunker-logs.conf by scripts/nginx-setup.sh
# when LOGS_INGEST_ENABLED=true.
#
# Write-only log ingestion from other servers running Vector. Two independent
# gates, both must pass: an IP allowlist and a separate htpasswd. Separate on
# purpose — these credentials live in config files on other machines, so they
# must not be the password that opens your panels.

location /insert/ {
    access_log off;

${LOGS_INGEST_ALLOW_DIRECTIVES}
    deny all;

    auth_basic           "PgBunker logs ingest";
    auth_basic_user_file /etc/nginx/pgbunker-ingest.htpasswd;

    proxy_pass http://127.0.0.1:9428;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout   300s;
    client_max_body_size 64m;
}
