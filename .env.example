# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=john
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=myapp

# Tuning for 2 vCPU / 4GB RAM / 60GB NVMe (default)
# See README for 1/2/4 vCPU preset values.
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=10MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_LOG_MIN_DURATION_STATEMENT=300

# Autovacuum
PG_AUTOVACUUM_MAX_WORKERS=2
PG_AUTOVACUUM_NAPTIME=15s

# Safety timeouts (0 = disabled).
# statement_timeout kills any single SQL taking too long. 0 by default — set
# per-role for OLTP users if you want coverage without hitting analytics jobs.
PG_STATEMENT_TIMEOUT=0
# idle_in_transaction_session_timeout kills clients that BEGIN and then sleep.
PG_IDLE_IN_TX_TIMEOUT=120s

# Storage-class tuning. Defaults target NVMe. For HDD set to 4 and 1.
PG_RANDOM_PAGE_COST=1.1
PG_EFFECTIVE_IO_CONCURRENCY=200

# PgBouncer
# PgBouncer is private by default. Docker binds it to 127.0.0.1 on the
# upstream port; host nginx only publishes the public port when
# PGBOUNCER_PUBLIC=true.
PGBOUNCER_UPSTREAM_PORT=16432
PGBOUNCER_PUBLIC=false
PGBOUNCER_PUBLIC_PORT=6432
PGBOUNCER_ALLOWED_CIDR=

# Public domain for admin UIs (Grafana / PgHero / Dozzle) and optional public DB.
# Before running scripts/nginx-setup.sh, point A-records to this VPS:
#   grafana.<DOMAIN>  -> VPS IP
#   pghero.<DOMAIN>   -> VPS IP
#   dozzle.<DOMAIN>   -> VPS IP
#   <DOMAIN>          -> VPS IP   (only when PGBOUNCER_PUBLIC=true and PGBOUNCER_TLS=true)
DOMAIN=example.com
LE_EMAIL=you@example.com

# PgBouncer TLS. When PGBOUNCER_PUBLIC=true and PGBOUNCER_TLS=true,
# nginx-setup.sh also issues a cert for <DOMAIN> and installs a Let's Encrypt
# deploy-hook that reloads PgBouncer on renewal. Apps then connect with
# sslmode=require. See README for details.
PGBOUNCER_TLS=false

# Auto-managed by setup.sh — reflects PGBOUNCER_TLS.
PGBOUNCER_EXPORTER_SSLMODE=disable

# Admin port binding: 127.0.0.1 by default, access via SSH tunnel.
# Set to 0.0.0.0 to expose Grafana/PgHero/Dozzle directly (then restrict via UFW).
ADMIN_BIND=127.0.0.1

# Container memory limits (defaults target 2 vCPU / 4GB RAM).
# See README for 1/2/4 vCPU preset values.
POSTGRES_MEM_LIMIT=1536m
PGBOUNCER_MEM_LIMIT=128m
POSTGRES_EXPORTER_MEM_LIMIT=128m
PGBOUNCER_EXPORTER_MEM_LIMIT=64m
NODE_EXPORTER_MEM_LIMIT=64m
PROMETHEUS_MEM_LIMIT=512m
GRAFANA_MEM_LIMIT=256m
PGHERO_MEM_LIMIT=384m
DOZZLE_MEM_LIMIT=128m
BACKUP_MEM_LIMIT=256m

# Node exporter
# Linux (Ubuntu, default): ro,rslave
# macOS (local dev only):  ro
NODE_EXPORTER_HOST_MOUNT_OPTIONS=ro,rslave

# Prometheus retention
PROM_RETENTION_TIME=30d
PROM_RETENTION_SIZE=3GB

# Backups (S3, optional "backup" profile)
BACKUP_ALERTS_ENABLED=false
S3_REGION=eu-central-1
S3_BUCKET=your-backup-bucket
S3_PREFIX=postgres
S3_ACCESS_KEY_ID=your_access_key_id_here
S3_SECRET_ACCESS_KEY=your_secret_access_key_here
S3_ENDPOINT=

# Grafana
GRAFANA_ADMIN_USER=john
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# PGHero
PGHERO_USERNAME=john
PGHERO_PASSWORD=your_pghero_password_here
