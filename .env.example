# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=john
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=myapp

# Tuning for 2 vCPU / 4GB RAM / 60GB NVME
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=10MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_LOG_MIN_DURATION_STATEMENT=300

# Autovacuum
PG_AUTOVACUUM_MAX_WORKERS=2
PG_AUTOVACUUM_NAPTIME=15s

# PgBouncer
PGBOUNCER_LISTEN_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_MIN_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_SIZE=5
PGBOUNCER_AUTH_TYPE=plain
PGBOUNCER_ADMIN_USERS=${POSTGRES_USER}

# Prometheus retention
PROM_RETENTION_TIME=30d
PROM_RETENTION_SIZE=3GB

# Grafana
GRAFANA_ADMIN_USER=john
GRAFANA_ADMIN_PASSWORD=your_password_here

# PGHero
PGHERO_USERNAME=john
PGHERO_PASSWORD=your_password_here
